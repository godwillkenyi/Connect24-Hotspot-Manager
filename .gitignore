.env.*
!.env.example

# Local router config — CONTAINS YOUR PASSWORD
.cache/
config.json
vendor/
config.php
config.local.php
config.*.php

# Session cookies captured by curl/Postman
cookies.txt
cookies-*.txt

# ============================================================
# Logs
# ============================================================
*.log
logs/
*.pid

# ============================================================
# OS junk
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

