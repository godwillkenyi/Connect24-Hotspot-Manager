# ============================================================
# Connect24 — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` file to version control.
# ============================================================

# ------------------------------------------------------------
# MikroTik Router Connection
# ------------------------------------------------------------
ROUTER_HOST=192.168.88.1
ROUTER_USER=connect24
ROUTER_PASS=changeme
ROUTER_PORT=443
ROUTER_TLS=true

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME="Connect24"
APP_URL=http://localhost:8080
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0

# ------------------------------------------------------------
# Session
# ------------------------------------------------------------
# Generate a random 64-char string for SESSION_SECRET, e.g.:
#   php -r "echo bin2hex(random_bytes(32));"
SESSION_LIFETIME=3600
SESSION_SECRET=

# ------------------------------------------------------------
# Admin Credentials
# ------------------------------------------------------------
# Change these immediately after first install.
ADMIN_USER=admin
ADMIN_PASS=admin

# ------------------------------------------------------------
# Optional: Demo mode
# ------------------------------------------------------------
# When true, the app serves canned JSON instead of hitting the router.
DEMO_MODE=false